{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.mjs --port 4173",
      "startServerReadyPattern": "ScoutLens static server listening",
      "url": ["http://127.0.0.1:4173/lab/"],
      "numberOfRuns": 3,
      "puppeteerScript": "scripts/lhci-puppeteer.cjs",
      "puppeteerLaunchOptions": {
        "args": ["--no-sandbox"]
      },
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 360,
          "height": 800,
          "deviceScaleFactor": 1,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 60,
          "throughputKbps": 9000,
          "requestLatencyMs": 0,
          "downloadThroughputKbps": 0,
          "uploadThroughputKbps": 0,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
