{
  "name": "@scoutlens/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.14.x",
    "pnpm": "11.9.x"
  },
  "scripts": {
    "assets:sync": "node scripts/sync-showcase.mjs",
    "budget:check": "node scripts/check-budgets.mjs",
    "check:baseline-pairs": "node scripts/check-visual-baseline-pairs.mjs",
    "build": "pnpm assets:sync && next build && pnpm static:check",
    "build:fixtures": "node scripts/build-all-fixtures.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "dev": "pnpm assets:sync && next dev",
    "lighthouse": "node scripts/run-lighthouse-ci.mjs",
    "lint": "eslint . --max-warnings=0",
    "quality": "pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "release:check": "pnpm quality && pnpm budget:check && pnpm test:e2e && pnpm lighthouse",
    "serve:static": "node scripts/serve-static.mjs --port 4173",
    "static:check": "node scripts/check-static-output.mjs",
    "test": "pnpm assets:sync && vitest run",
    "test:e2e": "pnpm build:fixtures && pnpm build && playwright test",
    "test:e2e:update": "playwright test e2e/visual.spec.ts --update-snapshots",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "json-schema-to-typescript": "15.0.4",
    "puppeteer-core": "24.43.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
